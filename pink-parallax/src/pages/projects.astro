---
/**
 * projects.astro - Portfolio Projects Showcase Page
 *
 * This page displays the user's portfolio projects with an immersive
 * 3D animated plant background. It demonstrates advanced CSS techniques
 * like glassmorphism and combines them with Three.js for a stunning
 * visual presentation.
 *
 * Key Features:
 * - Animated 3D carnivorous plant background
 * - Glassmorphism design with backdrop blur effects
 * - Responsive layout that works on all devices
 * - Dark/light theme support with appropriate transparency
 * - Centered content card with professional styling
 * - Placeholder content ready for real project data
 *
 * Technical Implementation:
 * - PlantBackground component provides immersive 3D visuals
 * - CSS backdrop-filter creates modern glass effect
 * - Flexbox layout ensures proper centering and responsiveness
 * - CSS custom properties enable consistent theming
 * - Layered z-index system for proper visual stacking
 */

// Import the base layout for consistent page structure
import BaseLayout from "../layouts/BaseLayout.astro";

// Import the 3D animated plant background component
import PlantBackground from "../components/PlantBackground.jsx";
---

<!-- Wrap content in BaseLayout with "Projects" page title -->
<BaseLayout title="Projects">
  <!-- 3D Animated Background -->
  <!-- client:load ensures the React/Three.js component hydrates on the client -->
  <!-- This component will render behind the main content as a visual backdrop -->
  <PlantBackground client:load />

  <!-- Main content container - provides centering and spacing -->
  <div class="projects-container">
    <!-- Content card with glassmorphism effect -->
    <div class="projects-content">
      <!-- Page heading -->
      <h1>My Projects</h1>

      <!-- Introductory text -->
      <p>Here are some of the projects I've worked on:</p>

      <!-- Project list - currently placeholder content -->
      <!-- TODO: Replace with actual project cards/components -->
      <ul>
        <li>Project 1: A brief description.</li>
        <li>Project 2: Another cool project.</li>
      </ul>

      <!-- Navigation link back to homepage -->
      <a href="/">Back to Home</a>
    </div>
  </div>
</BaseLayout>

<style>
  /**
   * Projects Page Styling
   *
   * Creates a full-screen immersive experience with a floating
   * content card that uses modern glassmorphism design principles.
   * The styling ensures the 3D background is visible while maintaining
   * excellent readability of the foreground content.
   */

  /* Main container - full viewport with centered flex layout */
  .projects-container {
    width: 100%; /* Fill entire viewport width */
    min-height: 100vh; /* At least full viewport height */
    padding: var(--spacing-lg); /* Large padding from edges (24px) */
    display: flex; /* Flexbox for easy centering */
    justify-content: center; /* Center horizontally */
    align-items: flex-start; /* Align to top (not center) for better mobile UX */
  }

  /* Content card - glassmorphism design with modern visual effects */
  .projects-content {
    padding: var(--spacing-xl); /* Extra large internal padding (32px) */

    /* Glassmorphism background - semi-transparent with blur */
    background: rgba(255, 255, 255, 0.85); /* 85% opaque white */

    border-radius: var(--border-radius-md); /* Medium rounded corners (8px) */
    box-shadow: var(--box-shadow-lg); /* Large shadow for depth */

    /* Modern backdrop blur effect - creates glass-like appearance */
    backdrop-filter: blur(10px); /* Blurs background behind card */

    border: 1px solid rgba(255, 255, 255, 0.2); /* Subtle transparent border */
    text-align: center; /* Center all text content */
    max-width: 800px; /* Constrain width for readability */
  }

  /* Dark theme variant - adjusts colors for dark mode */
  html[data-theme="dark"] .projects-content {
    /* Dark glassmorphism - semi-transparent dark background */
    background: rgba(26, 26, 26, 0.85); /* 85% opaque dark gray */

    /* Lighter border for contrast against dark background */
    border: 1px solid rgba(255, 255, 255, 0.1); /* Very subtle white border */
  }
</style>
